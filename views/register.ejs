<section class="auth-shell">
  <div class="auth-shell__layout auth-shell__layout--panel-scroll">
    <aside class="auth-showcase auth-showcase--register" aria-hidden="false">
      <a href="/" class="auth-showcase__brand">
        <img
          src="/images/ic_transparent.png"
          alt=""
          width="32"
          height="32"
          class="h-8 w-8 shrink-0 object-contain"
          decoding="async"
        />
        <span class="auth-showcase__brand-text"><%= appName %></span>
      </a>
      <h1>Create your<br />account</h1>
      <p>Let's get you started with your FindIt account.</p>
    </aside>

    <div class="auth-panel auth-panel--register">
      <div class="auth-panel__card">
        <h2 class="text-lg font-bold text-main mb-0.5">Create Account</h2>
        <p class="text-sm text-secondary mb-2">Fill in the details to get started.</p>

        <% if (typeof oauthErrors !== 'undefined' && oauthErrors.length) { %>
        <div class="alert alert-danger mb-2" role="alert">
          <p class="fi-notice__lead text-xs font-semibold">We couldn't finish sign-in.</p>
          <ul class="fi-notice__list text-xs">
            <% oauthErrors.forEach((msg) => { %>
            <li><%= msg %></li>
            <% }) %>
          </ul>
        </div>
        <% } %>

        <form method="POST" action="/register" novalidate class="space-y-2" data-auth-form>
          <input type="hidden" name="next" value="<%= typeof nextUrl !== 'undefined' ? nextUrl : '/' %>" />
          <div class="visually-hidden" aria-hidden="true">
            <label for="auth_hp_reg">Leave blank</label>
            <input
              type="text"
              name="_hp_mi"
              id="auth_hp_reg"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              inputmode="none"
            />
          </div>

          <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="alert alert-danger mb-2" role="alert" data-auth-server-errors>
            <p class="fi-notice__lead text-sm font-semibold">Fix these:</p>
            <ul class="fi-notice__list text-xs">
              <% errors.forEach(err => { %>
              <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
          <div class="alert alert-danger d-none" role="alert" data-auth-client-errors hidden></div>

          <div class="grid grid-cols-2 gap-1.5">
            <div class="field">
              <label for="firstName" class="field-label text-xs">First Name</label>
              <input
                type="text"
                class="field-input"
                id="firstName"
                name="firstName"
                placeholder="John"
                value="<%= formData.firstName || '' %>"
                required
                autocomplete="given-name"
                data-validate="required"
              />
              <div class="invalid-feedback">First name is required.</div>
            </div>
            <div class="field">
              <label for="lastName" class="field-label text-xs">Last Name</label>
              <input
                type="text"
                class="field-input"
                id="lastName"
                name="lastName"
                placeholder="Doe"
                value="<%= formData.lastName || '' %>"
                required
                autocomplete="family-name"
                data-validate="required"
              />
              <div class="invalid-feedback">Last name is required.</div>
            </div>
          </div>

          <div class="field">
            <label for="email" class="field-label">Email</label>
            <input
              type="email"
              class="field-input"
              id="email"
              name="email"
              placeholder="you@example.com"
              value="<%= formData.email || '' %>"
              required
              autocomplete="email"
              data-validate="email"
            />
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>

          <div class="field">
            <label for="password" class="field-label">Password</label>
            <div class="relative">
              <input
                type="password"
                class="field-input"
                id="password"
                name="password"
                placeholder="At least 8 characters"
                value="<%= formData.password || '' %>"
                required
                autocomplete="new-password"
                data-validate="password"
                data-pw-meter
              />
              <button
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted-custom hover:text-main"
                data-toggle-password="#password"
                aria-label="Show password"
                style="background: transparent; border: none; cursor: pointer"
              >
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="invalid-feedback">At least 8 characters.</div>
          </div>

          <div class="field">
            <label for="confirmPassword" class="field-label">Confirm Password</label>
            <div class="relative">
              <input
                type="password"
                class="field-input"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Confirm password"
                value="<%= formData.confirmPassword || '' %>"
                required
                autocomplete="new-password"
                data-validate="confirmPassword"
              />
              <button
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted-custom hover:text-main"
                data-toggle-password="#confirmPassword"
                aria-label="Show password"
                style="background: transparent; border: none; cursor: pointer"
              >
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="invalid-feedback">Passwords must match.</div>
          </div>

          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              id="terms"
              name="agreeTerms"
              value="1"
              required
              data-validate="terms"
            />
            <label class="form-check-label text-xs" for="terms" style="color: var(--text-secondary)">
              I agree to the <a href="/terms" class="text-primary text-decoration-none">Terms</a> and
              <a href="/privacy" class="text-primary text-decoration-none">Privacy Policy</a>
            </label>
            <div class="invalid-feedback">You must agree to the terms.</div>
          </div>

          <button type="submit" class="btn btn-primary w-full" data-loading-text="Creating account...">Sign Up</button>
        </form>

        <%- include('partials/oauth-buttons') %>

        <p class="text-center text-xs mt-2 text-secondary">
          Already have an account?
          <a href="/login" class="text-decoration-none text-primary font-medium hover:opacity-70">Login</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-auth-form]");
    if (!form) return;
    const toggleBtns = form.querySelectorAll("[data-toggle-password]");
    toggleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = form.querySelector(btn.getAttribute("data-toggle-password"));
        if (!target) return;
        const nextType = target.type === "password" ? "text" : "password";
        target.type = nextType;
        btn.innerHTML = nextType === "password" ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
      });
    });
    const clientBanner = form.querySelector("[data-auth-client-errors]");
    const renderErrorBanner = (target, messages) => {
      if (!target) return;
      if (window.finditFeedback && typeof window.finditFeedback.resetEnhancement === 'function') {
        window.finditFeedback.resetEnhancement(target);
      }
      const safeMessages =
        Array.isArray(messages) && messages.length ? messages : ["Please correct the highlighted fields."];
      target.innerHTML =
        '<p class="fi-notice__lead text-sm font-semibold">Fix these:</p>' +
        '<ul class="fi-notice__list text-xs">' +
        safeMessages.map((m) => "<li>" + m + "</li>").join("") +
        "</ul>";
      target.classList.remove("d-none");
      target.removeAttribute("hidden");
      if (window.finditFeedback && typeof window.finditFeedback.enhanceAlert === "function") {
        window.finditFeedback.enhanceAlert(target);
      }
    };
    const hideClientBanner = () => {
      if (!clientBanner) return;
      if (window.finditFeedback && typeof window.finditFeedback.resetEnhancement === 'function') {
        window.finditFeedback.resetEnhancement(clientBanner);
      }
      clientBanner.classList.add("d-none");
      clientBanner.setAttribute("hidden", "");
      clientBanner.innerHTML = "";
    };
    const inputs = form.querySelectorAll("[data-validate]");
    const touched = new WeakSet();
    let hasSubmitted = false;
    const getInputValidity = (input) => {
      const kind = input.getAttribute("data-validate");
      const trimmed = String(input.value || "").trim();
      let ok = true;
      if (kind === "email") ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed);
      else if (kind === "password") ok = trimmed.length >= 8;
      else if (kind === "confirmPassword") {
        const pw = form.querySelector("#password");
        ok = trimmed === (pw?.value || "");
      } else if (kind === "terms") {
        const cb = form.querySelector("#terms");
        ok = cb?.checked;
      } else ok = trimmed.length > 0;
      return { ok, trimmed };
    };
    const validateInput = (input, opts = {}) => {
      const { showInvalid = true, showValid = true } = opts;
      const { ok, trimmed } = getInputValidity(input);
      const field = input.closest(".field, .form-check");
      input.classList.remove("is-server-invalid-silent");
      if (field) field.classList.remove("field-server-invalid-silent");
      if (showInvalid) input.classList.toggle("is-invalid", !ok);
      else input.classList.remove("is-invalid");
      if (showValid) input.classList.toggle("is-valid", ok && (trimmed.length > 0 || input.type === "checkbox"));
      else input.classList.remove("is-valid");
      if (field) field.classList.toggle("field-invalid", showInvalid && !ok);
      return ok;
    };
    const allInputsValid = () => {
      let a = true;
      inputs.forEach((el) => {
        if (!getInputValidity(el).ok) a = false;
      });
      return a;
    };
    const applyInitialValidationState = () => {
      inputs.forEach((input) => validateInput(input, { showInvalid: false, showValid: false }));
    };
    const applyServerAuthErrorState = () => {
      const serverErrorItems = form.querySelectorAll("[data-auth-server-errors] li");
      const normalizedErrors = Array.from(serverErrorItems).map((item) =>
        String(item?.textContent || "")
          .trim()
          .toLowerCase()
      );
      if (!normalizedErrors.length) return;
      const markDisposableEmail = () => {
        const input = form.querySelector("#email");
        if (!input) return;
        const field = input.closest(".field");
        touched.add(input);
        input.classList.add("is-invalid");
        input.classList.remove("is-valid");
        input.classList.add("is-server-invalid-silent");
        if (field) {
          field.classList.remove("field-invalid");
          field.classList.add("field-server-invalid-silent");
        }
      };
      if (normalizedErrors.some((msg) => msg.includes("disposable or temporary emails are not allowed"))) {
        markDisposableEmail();
      }
    };
    inputs.forEach((input) => {
      const eventType = input.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventType, () => {
        const shouldShowInvalid = hasSubmitted || touched.has(input) || input.classList.contains("is-invalid");
        validateInput(input, { showInvalid: shouldShowInvalid, showValid: true });
        if (allInputsValid()) hideClientBanner();
      });
      input.addEventListener("blur", () => {
        touched.add(input);
        validateInput(input, { showInvalid: true, showValid: true });
      });
    });
    form.addEventListener("submit", (event) => {
      hasSubmitted = true;
      const messages = [];
      let allValid = true;
      inputs.forEach((input) => {
        touched.add(input);
        if (!validateInput(input, { showInvalid: true, showValid: true })) {
          allValid = false;
          const field = input.closest(".field, .form-check");
          const hint = field?.querySelector(".invalid-feedback");
          const text = hint?.textContent?.trim() || "";
          if (text && !messages.includes(text)) messages.push(text);
        }
      });
      if (!allValid) {
        event.preventDefault();
        renderErrorBanner(clientBanner, messages);
        return;
      }
      hideClientBanner();
      const submitBtn = form.querySelector("[data-loading-text]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitBtn.getAttribute("data-loading-text") || "Submitting...";
      }
    });
    applyInitialValidationState();
    applyServerAuthErrorState();
  })();
</script>
