<section class="py-10 sm:py-14 bg-page min-h-screen">
  <div class="gutter max-w-2xl mx-auto">
    <a
      href="/dashboard"
      class="inline-flex items-center gap-1 text-sm text-secondary mb-6 text-decoration-none hover:text-main"
    >
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    <h1 class="title mb-1">Edit Report</h1>
    <p class="text-sm text-secondary mb-8">Update item details, contact info, and report status.</p>

    <% if (errors.length > 0) { %>
    <div class="alert alert-danger mb-6" role="alert">
      <ul class="fi-notice__list text-xs">
        <% errors.forEach(err => { %>
        <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <form method="POST" action="/items/<%= item.id %>/edit" enctype="multipart/form-data" novalidate class="space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="field">
          <label class="field-label">Report Type</label>
          <select class="field-input" name="type" required>
            <% if (formData.type === 'lost') { %>
            <option value="lost" selected>Lost</option>
            <% } else { %>
            <option value="lost">Lost</option>
            <% } %>
            <% if (formData.type === 'found') { %>
            <option value="found" selected>Found</option>
            <% } else { %>
            <option value="found">Found</option>
            <% } %>
          </select>
        </div>
        <div class="field">
          <label class="field-label">Status</label>
          <select class="field-input" name="status" required>
            <% if (formData.status === 'active') { %>
            <option value="active" selected>Active</option>
            <% } else { %>
            <option value="active">Active</option>
            <% } %>
            <% if (formData.status === 'claimed') { %>
            <option value="claimed" selected>Claimed</option>
            <% } else { %>
            <option value="claimed">Claimed</option>
            <% } %>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="title" class="field-label">Item Title</label>
        <input type="text" class="field-input" id="title" name="title" value="<%= formData.title || '' %>" required />
      </div>

      <div class="field">
        <label for="description" class="field-label">Description</label>
        <textarea class="field-input" id="description" name="description" rows="4" required>
<%= formData.description || '' %></textarea
        >
      </div>

      <div class="field">
        <span class="field-label">Photos <span class="text-muted-custom font-normal">(optional)</span></span>
        <p class="text-xs text-muted-custom mt-1 mb-2">Up to 8 images · JPG, PNG, or WEBP · max 8 MB each</p>

        <%
          let _existingUrls = [];
          try {
            const _raw = typeof formData.imagesJson !== 'undefined' ? formData.imagesJson : (item.imagesJson || null);
            if (_raw) {
              const _parsed = typeof _raw === 'string' ? JSON.parse(_raw) : _raw;
              if (Array.isArray(_parsed)) _existingUrls = _parsed;
            }
          } catch(_e) {}
        %>

        <input type="hidden" name="removeImages" id="edit-remove-images-input" value="" />
        <input
          type="file"
          class="visually-hidden"
          id="edit-photos-input"
          name="photos"
          accept="image/jpeg,image/png,image/webp"
          multiple
          tabindex="-1"
          aria-hidden="true"
        />
        <div id="edit-photo-errors" class="report-photo-errors" role="alert" hidden></div>
        <div
          id="edit-photo-grid"
          class="report-photo-grid"
          role="group"
          aria-label="Item photos"
        >
          <% _existingUrls.forEach(function(url, idx) { %>
          <div class="report-photo-slot" id="edit-existing-slot-<%= idx %>" data-existing="1">
            <img
              src="<%= url %>"
              alt="Item photo <%= idx + 1 %>"
              class="report-photo-slot__img"
              referrerpolicy="no-referrer"
              loading="lazy"
            />
            <button
              type="button"
              class="report-photo-remove"
              aria-label="Remove photo"
              data-remove-existing="<%= url %>"
              onclick="editRemoveExisting(this, '<%= idx %>')"
            ><i class="bi bi-x-lg" aria-hidden="true"></i></button>
          </div>
          <% }) %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="field">
          <label for="category" class="field-label">Category</label>
          <select class="field-input" id="category" name="category" required>
            <% categories.forEach(cat => { %>
            <% if (formData.category === cat) { %>
            <option value="<%= cat %>" selected><%= cat %></option>
            <% } else { %>
            <option value="<%= cat %>"><%= cat %></option>
            <% } %>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="date" class="field-label">Date Lost/Found</label>
          <input type="date" class="field-input" id="date" name="date" value="<%= formData.date || '' %>" required />
        </div>
      </div>

      <div class="field">
        <label for="location" class="field-label">Location</label>
        <input
          type="text"
          class="field-input"
          id="location"
          name="location"
          value="<%= formData.location || '' %>"
          required
        />
      </div>

      <div class="border-t-base pt-5">
        <h3 class="text-sm font-bold text-main mb-3">Contact Information</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="field">
            <label for="contactName" class="field-label">Contact Name</label>
            <input
              type="text"
              class="field-input"
              id="contactName"
              name="contactName"
              value="<%= formData.contactName || '' %>"
              required
            />
          </div>
          <div class="field">
            <label for="contactEmail" class="field-label">Contact Email</label>
            <input
              type="email"
              class="field-input"
              id="contactEmail"
              name="contactEmail"
              value="<%= formData.contactEmail || '' %>"
              required
            />
          </div>
        </div>
      </div>

      <div class="rounded-xl p-4" style="background: var(--surface-2); border: 1px solid var(--border)">
        <div class="text-sm font-semibold text-main mb-3">
          <i class="bi bi-shield-check me-1 text-primary"></i> Verification
        </div>
        <div class="space-y-3">
          <div class="field">
            <label for="verificationPrompt" class="field-label text-xs">Verification question</label>
            <input
              type="text"
              class="field-input"
              id="verificationPrompt"
              name="verificationPrompt"
              value="<%= formData.verificationPrompt || '' %>"
              maxlength="255"
            />
          </div>
          <div class="field">
            <label for="verificationAnswer" class="field-label text-xs">Expected answer</label>
            <input
              type="text"
              class="field-input"
              id="verificationAnswer"
              name="verificationAnswer"
              value="<%= formData.verificationAnswer || '' %>"
              maxlength="200"
              placeholder="Required when question is set"
            />
          </div>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary" id="edit-submit-btn"><i class="bi bi-check2-circle me-1"></i>Save changes</button>
        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</section>

<style>
  .edit-existing-photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.75rem, 1fr));
    gap: 0.65rem;
    max-width: 100%;
  }
  .report-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.75rem, 1fr));
    gap: 0.65rem;
    max-width: 100%;
  }
  .report-photo-slot {
    position: relative;
    aspect-ratio: 1;
    border-radius: 1.05rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-2);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }
  [data-bs-theme="dark"] .report-photo-slot {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .report-photo-slot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transition: opacity 0.2s ease;
  }
  .report-photo-slot__shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.38rem 0.42rem 0.42rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.2) 55%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }
  .report-photo-slot__name {
    display: block;
    font-size: 0.62rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .report-photo-slot__size {
    display: block;
    font-size: 0.58rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 1px;
    letter-spacing: 0.02em;
  }
  .report-photo-remove {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 3;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    color: #fff;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(6px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .report-photo-remove:hover {
    background: rgba(220, 38, 38, 0.92);
    transform: scale(1.06);
  }
  .report-photo-add {
    aspect-ratio: 1;
    border-radius: 1.05rem;
    border: 2px dashed color-mix(in srgb, var(--border-strong) 85%, var(--primary));
    background: color-mix(in srgb, var(--surface) 92%, var(--surface-2));
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 0;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .report-photo-add:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-bg);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .report-photo-add:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .report-photo-add i {
    font-size: 1.45rem;
    line-height: 1;
  }
  .report-photo-add span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .report-photo-errors {
    color: var(--danger);
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
</style>

<script>
  (() => {
    const MAX_FILES = 8;
    const MAX_BYTES = 8 * 1024 * 1024;
    const MIME_OK = new Set(["image/jpeg", "image/png", "image/webp"]);

    const fileInput = document.getElementById("edit-photos-input");
    const grid = document.getElementById("edit-photo-grid");
    const errEl = document.getElementById("edit-photo-errors");
    const removeInput = document.getElementById("edit-remove-images-input");
    if (!fileInput || !grid) return;

    const files = [];

    function countExisting() {
      return grid.querySelectorAll(".report-photo-slot[data-existing]:not([hidden])").length;
    }

    function fmtSize(n) {
      if (n < 1024) return n + " B";
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
      return (n / (1024 * 1024)).toFixed(2) + " MB";
    }

    function showError(msg) {
      if (!errEl) return;
      if (!msg) { errEl.textContent = ""; errEl.hidden = true; return; }
      errEl.textContent = msg;
      errEl.hidden = false;
      window.clearTimeout(showError._t);
      showError._t = window.setTimeout(() => { errEl.textContent = ""; errEl.hidden = true; }, 5200);
    }

    function syncInput() {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      fileInput.files = dt.files;
      removeInput.value = Array.from(removedUrls).join(",");
    }

    function render() {
      // Remove only dynamically-added new-file slots and the Add button; keep existing (server-rendered) slots
      grid.querySelectorAll(".report-photo-slot[data-new], .report-photo-add").forEach((el) => el.remove());

      files.forEach((file) => {
        const blobUrl = URL.createObjectURL(file);
        const wrap = document.createElement("div");
        wrap.className = "report-photo-slot";
        wrap.dataset.new = "1";
        const img = document.createElement("img");
        img.className = "report-photo-slot__img";
        img.alt = "";
        img.decoding = "async";
        img.src = blobUrl;
        const shade = document.createElement("div");
        shade.className = "report-photo-slot__shade";
        const nameSpan = document.createElement("span");
        nameSpan.className = "report-photo-slot__name";
        nameSpan.textContent = file.name.length > 26 ? file.name.slice(0, 24) + "…" : file.name;
        const sizeSpan = document.createElement("span");
        sizeSpan.className = "report-photo-slot__size";
        sizeSpan.textContent = fmtSize(file.size);
        shade.appendChild(nameSpan);
        shade.appendChild(sizeSpan);
        const rm = document.createElement("button");
        rm.type = "button";
        rm.className = "report-photo-remove";
        rm.setAttribute("aria-label", "Remove photo");
        rm.innerHTML = '<i class="bi bi-x-lg" aria-hidden="true"></i>';
        rm.addEventListener("click", () => {
          try { URL.revokeObjectURL(blobUrl); } catch (_e) {}
          const i = files.indexOf(file);
          if (i !== -1) files.splice(i, 1);
          syncInput();
          render();
        });
        wrap.appendChild(img);
        wrap.appendChild(shade);
        wrap.appendChild(rm);
        grid.appendChild(wrap);
      });

      const totalSlots = countExisting() + files.length;
      if (totalSlots < MAX_FILES) {
        const add = document.createElement("button");
        add.type = "button";
        add.className = "report-photo-add";
        add.setAttribute("aria-label", "Add photos");
        add.innerHTML = '<i class="bi bi-plus-lg" aria-hidden="true"></i><span>Add</span>';
        add.addEventListener("click", () => fileInput.click());
        grid.appendChild(add);
      }

      syncInput();
    }

    fileInput.addEventListener("change", () => {
      const picked = Array.from(fileInput.files || []);
      fileInput.value = "";
      for (let i = 0; i < picked.length; i++) {
        const f = picked[i];
        const total = countExisting() + files.length;
        if (total >= MAX_FILES) { showError("You can attach at most " + MAX_FILES + " images total."); break; }
        if (!MIME_OK.has(f.type)) { showError("Only JPG, PNG, or WEBP images are allowed."); continue; }
        if (f.size > MAX_BYTES) { showError("Each image must be 8 MB or smaller."); continue; }
        const dup = files.some((x) => x.name === f.name && x.size === f.size && x.lastModified === f.lastModified);
        if (dup) continue;
        files.push(f);
      }
      render();
    });

    render();
  })();

  function editRemoveExisting(btn, idx) {
    const url = btn.getAttribute("data-remove-existing");
    const slot = document.getElementById("edit-existing-slot-" + idx);
    if (slot) slot.hidden = true;
    const removeInput = document.getElementById("edit-remove-images-input");
    const current = removeInput.value ? removeInput.value.split(",").filter(Boolean) : [];
    if (url && !current.includes(url)) current.push(url);
    removeInput.value = current.join(",");
    // Re-render so the Add button count updates
    const grid = document.getElementById("edit-photo-grid");
    const add = grid && grid.querySelector(".report-photo-add");
    if (add) add.remove();
    const MAX_FILES = 8;
    const visibleExisting = grid ? grid.querySelectorAll(".report-photo-slot[data-existing]:not([hidden])").length : 0;
    const newSlots = grid ? grid.querySelectorAll(".report-photo-slot[data-new]").length : 0;
    if (visibleExisting + newSlots < MAX_FILES) {
      const fileInput = document.getElementById("edit-photos-input");
      const addBtn = document.createElement("button");
      addBtn.type = "button";
      addBtn.className = "report-photo-add";
      addBtn.setAttribute("aria-label", "Add photos");
      addBtn.innerHTML = '<i class="bi bi-plus-lg" aria-hidden="true"></i><span>Add</span>';
      addBtn.addEventListener("click", () => fileInput && fileInput.click());
      grid.appendChild(addBtn);
    }
  }
</script>
