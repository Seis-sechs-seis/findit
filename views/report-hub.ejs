<section class="min-h-screen flex flex-col items-center justify-center py-16 bg-page">
  <div class="gutter max-w-xl mx-auto text-center">
    <h1 class="text-2xl sm:text-3xl font-bold text-main mb-2">What do you want to report?</h1>
    <p class="text-sm text-secondary mb-10">Choose the right flow so your post is clear and easier to match.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href="/items/report?type=lost" class="report-hub-card card-surface text-decoration-none">
        <div class="report-hub-card__icon report-hub-card__icon--lost">
          <i class="bi bi-exclamation-circle"></i>
        </div>
        <h3 class="text-lg font-bold text-main mb-1">Report Lost Item</h3>
        <p class="text-sm text-secondary mb-3">I lost something and want others to help me find it.</p>
        <span class="btn btn-secondary btn-sm">Continue <i class="bi bi-arrow-right ms-1"></i></span>
      </a>

      <a href="/items/report?type=found" class="report-hub-card card-surface text-decoration-none">
        <div class="report-hub-card__icon report-hub-card__icon--found">
          <i class="bi bi-check-circle"></i>
        </div>
        <h3 class="text-lg font-bold text-main mb-1">Report Found Item</h3>
        <p class="text-sm text-secondary mb-3">I found an item and want to help return it to the owner.</p>
        <span class="btn btn-secondary btn-sm">Continue <i class="bi bi-arrow-right ms-1"></i></span>
      </a>
    </div>
  </div>
</section>
