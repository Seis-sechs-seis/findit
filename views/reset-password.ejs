<section class="auth-shell auth-shell--simple">
  <div class="auth-simple">
    <div class="auth-simple__card">
      <div class="auth-simple__mark" aria-hidden="true">
        <div class="auth-simple__mark-ring">
          <img
            src="/images/ic_transparent.png"
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 object-contain"
            decoding="async"
          />
        </div>
      </div>

      <h2 class="text-center text-lg font-bold text-main mb-0.5">Create new password</h2>
      <p class="text-center text-sm text-secondary mb-4">Choose a strong password for your account.</p>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="alert alert-danger mb-3" role="alert">
        <p class="fi-notice__lead text-sm font-semibold">Fix these:</p>
        <ul class="fi-notice__list text-xs">
          <% errors.forEach(err => { %>
          <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success mb-4" role="alert" data-fi-dismiss-ms="6000"><%= success %></div>
      <a href="/login" class="btn btn-primary w-full">Go to login</a>
      <% } else { %>
      <form method="POST" action="/reset-password/<%= token %>" novalidate class="space-y-3" data-auth-form>
        <div class="field">
          <label for="password" class="field-label">New password</label>
          <div class="relative">
            <input
              type="password"
              class="field-input"
              id="password"
              name="password"
              placeholder="At least 8 characters"
              required
              minlength="8"
              autocomplete="new-password"
              data-validate="password"
              data-pw-meter
            />
            <button
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted-custom hover:text-main"
              data-toggle-password="#password"
              aria-label="Show password"
              style="background: transparent; border: none; cursor: pointer"
            >
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="invalid-feedback">At least 8 characters.</div>
        </div>

        <div class="field">
          <label for="confirmPassword" class="field-label">Confirm password</label>
          <div class="relative">
            <input
              type="password"
              class="field-input"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Re-enter password"
              required
              minlength="8"
              autocomplete="new-password"
              data-validate="confirm-password"
              data-match="#password"
            />
            <button
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted-custom hover:text-main"
              data-toggle-password="#confirmPassword"
              aria-label="Show password"
              style="background: transparent; border: none; cursor: pointer"
            >
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="invalid-feedback">Passwords must match.</div>
        </div>

        <button type="submit" class="btn btn-primary w-full" data-loading-text="Updating...">Reset password</button>
      </form>
      <% } %>

      <p class="text-center text-xs mt-4 text-secondary">
        <a href="/login" class="text-decoration-none text-primary hover:opacity-70">Back to login</a>
      </p>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-auth-form]");
    if (!form) return;
    const toggleBtns = form.querySelectorAll("[data-toggle-password]");
    toggleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = form.querySelector(btn.getAttribute("data-toggle-password"));
        if (!target) return;
        const nextType = target.type === "password" ? "text" : "password";
        target.type = nextType;
        btn.innerHTML = nextType === "password" ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
      });
    });
    const inputs = form.querySelectorAll("[data-validate]");
    let touched = new WeakSet();
    const validateInput = (input) => {
      const kind = input.getAttribute("data-validate");
      const value = String(input.value || "").trim();
      let ok = true;
      if (kind === "password") ok = value.length >= 8;
      else if (kind === "confirm-password") {
        const matchSelector = input.getAttribute("data-match");
        const passwordInput = matchSelector ? form.querySelector(matchSelector) : null;
        ok = value.length >= 8 && passwordInput && value === String(passwordInput.value || "");
      }
      if (touched.has(input)) {
        input.classList.toggle("is-invalid", !ok);
        input.classList.toggle("is-valid", ok && value.length > 0);
      }
      return ok;
    };
    inputs.forEach((input) => {
      input.addEventListener("input", () => {
        validateInput(input);
        if (input.id === "password") {
          const c = form.querySelector("#confirmPassword");
          if (c?.value) validateInput(c);
        }
      });
      input.addEventListener("blur", () => {
        touched.add(input);
        validateInput(input);
      });
    });
    form.addEventListener("submit", (event) => {
      let allValid = true;
      inputs.forEach((input) => {
        touched.add(input);
        if (!validateInput(input)) allValid = false;
      });
      if (!allValid) {
        event.preventDefault();
        return;
      }
      const submitBtn = form.querySelector("[data-loading-text]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitBtn.getAttribute("data-loading-text");
      }
    });
  })();
</script>
