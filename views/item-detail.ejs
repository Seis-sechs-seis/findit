<section class="py-10 sm:py-14 bg-page">
  <div class="gutter">
    <% const galleryImages = (Array.isArray(item.imageUrls) && item.imageUrls.length ? item.imageUrls :
    [item.imageUrl]).filter(Boolean); %> <% const safeGalleryImages = galleryImages.length ? galleryImages :
    ['/images/hero-bg.jpg']; %>
    <article class="item-layout">
      <!-- Left: gallery stays pinned while the detail column scrolls (desktop) -->
      <div class="item-gallery-sticky-wrap">
        <div class="item-gallery-rail">
          <div class="item-gallery card-surface" style="padding: 14px">
            <div class="item-gallery__hero" data-gallery-open role="button" tabindex="0" aria-label="Open image preview">
              <% if (item.emptyImagePlaceholder && item.placeholderImageDark) { %>
              <img
                data-gallery-main-image
                src="<%= item.imageUrl %>"
                alt="<%= item.title %>"
                loading="eager"
                referrerpolicy="no-referrer"
                class="absolute inset-0 h-full w-full object-cover dark:hidden"
                onerror="
                  this.onerror = null;
                  this.src = '/images/hero-bg.jpg';
                "
              />
              <img
                src="<%= item.placeholderImageDark %>"
                alt=""
                loading="eager"
                referrerpolicy="no-referrer"
                class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover dark:block"
                onerror="
                  this.onerror = null;
                  this.src = '/images/hero-bg.jpg';
                "
              />
              <% } else { %>
              <img
                src="<%= safeGalleryImages[0] %>"
                alt="<%= item.title %>"
                loading="eager"
                referrerpolicy="no-referrer"
                data-gallery-main-image
                onerror="
                  this.onerror = null;
                  this.src = '/images/hero-bg.jpg';
                "
              />
              <% } %>
              <span class="item-gallery__expand"><i class="bi bi-arrows-fullscreen"></i> Tap to expand</span>
            </div>
            <div class="item-gallery__thumbs">
              <% safeGalleryImages.forEach((imgUrl, idx) => { %>
              <button
                type="button"
                class="item-gallery__thumb <%= idx === 0 ? 'is-active' : '' %>"
                data-gallery-thumb
                data-src="<%= imgUrl %>"
                aria-label="View photo <%= idx + 1 %>"
              >
                <img
                  src="<%= imgUrl %>"
                  alt=""
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  onerror="
                    this.onerror = null;
                    this.src = '/images/hero-bg.jpg';
                  "
                />
              </button>
              <% }); %>
            </div>
          </div>
          <p class="item-gallery__reported text-xs text-muted-custom mb-0">
            <i class="bi bi-clock me-1" aria-hidden="true"></i>Reported on
            <%= new Date(item.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </p>
        </div>
      </div>

      <!-- Right: detail cards scroll with the page; gallery column uses sticky rail -->
      <div class="item-content">
        <div class="card-surface" style="padding: 18px">
          <!-- Status badges -->
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="status-pill <%= item.type === 'lost' ? 'status-pill--lost' : 'status-pill--found' %>">
              <i class="bi <%= item.type === 'lost' ? 'bi-exclamation-circle' : 'bi-check-circle' %> me-1"></i>
              <%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %>
            </span>
            <span class="item-card__category"><%= item.category %></span>
            <% if (item.status === 'claimed') { %>
            <span class="status-pill status-pill--claimed"><i class="bi bi-patch-check me-1"></i>Claimed</span>
            <% } %>
          </div>

          <h1 class="text-xl sm:text-2xl font-bold text-main mb-2"><%= item.title %></h1>
          <p class="text-sm leading-relaxed text-secondary mb-4"><%= item.description %></p>

          <!-- Metadata grid -->
          <div class="item-detail-meta">
            <div>
              <small class="item-detail-meta__label">Location</small>
              <span class="item-detail-meta__value"
                ><i class="bi bi-geo-alt me-1"></i
                ><%= item.location %></span
              >
            </div>
            <div>
              <small class="item-detail-meta__label">Date</small>
              <span class="item-detail-meta__value"
                ><i class="bi bi-calendar-event me-1"></i
                ><%= item.date %></span
              >
            </div>
            <div>
              <small class="item-detail-meta__label">Reporter</small>
              <div class="item-detail-reporter-slot" data-reporter-privacy-slot>
                <button
                  type="button"
                  class="item-detail-reporter-btn"
                  data-reporter-privacy-trigger
                  aria-expanded="false"
                  aria-controls="reporter-privacy-tip-<%= item.id %>"
                  title="Privacy protected. Public listings never show reporter email or account IDs. Use the contact request flow so details stay controlled."
                >
                  <span class="item-detail-meta__value item-detail-meta__value--reporter">
                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i
                    ><span class="item-detail-reporter-text"
                      ><% if (typeof isOwner !== 'undefined' && isOwner) { %>You<% } else if (typeof isAdmin !== 'undefined' && isAdmin && itemPrivate && itemPrivate.contactName && String(itemPrivate.contactName).trim()) { %><%= itemPrivate.contactName %><% } else { %><%= item.publicReporterLabel %><% } %></span
                    >
                  </span>
                </button>
                <div
                  id="reporter-privacy-tip-<%= item.id %>"
                  class="item-detail-reporter-tip"
                  data-reporter-privacy-tip
                  role="tooltip"
                  hidden
                >
                  Privacy protected. Public listings never show reporter email or account IDs. Use the contact request
                  flow so details stay controlled.
                </div>
              </div>
            </div>
          </div>
          <% if (itemPrivate && (isOwner || isAdmin)) { %>
          <div class="rounded-xl p-3 mt-3" style="background: var(--surface-2); border: 1px solid var(--border)">
            <small class="item-detail-meta__label"
              ><%= isOwner ? 'Your contact on file' : 'Reporter contact (admin)' %></small
            >
            <p class="text-sm font-medium text-main mb-0.5 mt-1"><%= itemPrivate.contactName %></p>
            <p class="text-sm text-secondary mb-0"><%= itemPrivate.contactEmail %></p>
          </div>
          <% } %>
        </div>

        <!-- Action card -->
        <div class="card-surface" style="padding: 18px">
          <h3 class="text-sm font-bold text-main mb-1"><i class="bi bi-chat-dots me-1"></i>Contact & Claim</h3>
          <p class="text-xs text-secondary mb-3">Email stays private until a request is approved by the owner.</p>

          <% if (!user) { %>
          <a href="/login?next=<%= encodeURIComponent('/items/' + item.id) %>" class="btn btn-primary w-full">
            <i class="bi bi-box-arrow-in-right me-1"></i><span class="sm:hidden">Login</span
            ><span class="hidden sm:inline">Log in to contact</span>
          </a>
          <% } else if (item.status !== 'claimed' && !isOwner && !isAdmin && item.canReceiveRequests) { %>
          <% if (ownRequest && ownRequest.status === 'pending') { %>
          <div class="flex items-center gap-2 flex-wrap mb-3">
            <span class="status-pill status-pill--lost">Contact request pending</span>
            <form
              method="POST"
              action="/items/<%= item.id %>/contact-request/<%= ownRequest.id %>/cancel"
              class="inline"
            >
              <button class="btn btn-secondary btn-sm" type="submit">
                <i class="bi bi-slash-circle me-1"></i>Cancel
              </button>
            </form>
          </div>
          <% } else if (ownRequest && ownRequest.status === 'approved') { %>
          <div
            class="rounded-xl p-4 mb-3"
            style="background: rgba(46, 216, 163, 0.06); border: 1px solid rgba(46, 216, 163, 0.2)"
          >
            <p class="text-sm font-semibold" style="color: #065f46">
              <i class="bi bi-check-circle me-1"></i>Request approved
            </p>
            <p class="text-xs mt-1 text-secondary mb-3">Continue the conversation in your shared thread.</p>
            <a href="/items/<%= item.id %>/contact/<%= ownRequest.id %>" class="btn btn-primary w-full btn-sm">
              <i class="bi bi-chat-dots me-1"></i>Open conversation
            </a>
          </div>
          <% } else if (ownRequest && ownRequest.status === 'closed') { %>
          <div class="rounded-xl p-4 mb-3" style="background: var(--surface-2); border: 1px solid var(--border)">
            <p class="text-sm font-semibold text-main mb-1">Conversation closed</p>
            <p class="text-xs text-secondary mb-3">You can still read the message history.</p>
            <a href="/items/<%= item.id %>/contact/<%= ownRequest.id %>" class="btn btn-outline w-full btn-sm">
              <i class="bi bi-chat-left-text me-1"></i>View thread
            </a>
          </div>
          <% } else if (ownRequest && ownRequest.status === 'rejected') { %>
          <span class="status-pill status-pill--lost">Contact request rejected</span>
          <% } else { %>
          <form method="POST" action="/items/<%= item.id %>/contact-request" class="space-y-3">
            <div class="field">
              <label for="message" class="field-label text-sm">Message (optional)</label>
              <textarea
                id="message"
                name="message"
                class="field-input"
                rows="2"
                maxlength="500"
                placeholder="Share why you think this item might be yours..."
              ></textarea>
            </div>
            <% if (item.hasVerification) { %>
            <div class="field">
              <label for="verificationResponse" class="field-label text-sm"
                >Verification:
                <%= item.verificationPrompt %></label
              >
              <input
                id="verificationResponse"
                name="verificationResponse"
                type="text"
                class="field-input"
                maxlength="200"
                required
              />
            </div>
            <% } %>
            <button class="btn btn-primary w-full" type="submit"><i class="bi bi-send me-1"></i>Submit Request</button>
          </form>
          <% } %>
          <% } else if (item.status !== 'claimed' && !item.canReceiveRequests) { %>
          <div class="rounded-xl p-3" style="background: var(--surface-2); border: 1px solid var(--border)">
            <p class="text-sm font-semibold text-main">Contact unavailable</p>
            <p class="text-xs mt-1 text-secondary">This report has no linked owner account yet.</p>
          </div>
          <% } else if (item.status !== 'claimed' && isOwner) { %>
          <a href="/requests" class="btn btn-secondary w-full mb-2">
            <i class="bi bi-chat-square-text me-1"></i>Requests inbox
          </a>
          <form method="POST" action="/items/<%= item.id %>/claim-as-owner" class="mb-0">
            <input type="hidden" name="next" value="/items/<%= item.id %>" />
            <button class="btn btn-primary w-full" type="submit">
              <i class="bi bi-patch-check me-1"></i>Claimed
            </button>
          </form>
          <p class="text-xs text-secondary mt-2 mb-0">Use Requests to chat with people who reached out about this listing.</p>
          <% } else if (item.status !== 'claimed' && isAdmin && !isOwner) { %>
          <p class="text-xs text-secondary mb-0">Manage this report from the admin dashboard (edit, status, delete).</p>
          <% } %>
        </div>
      </div>
    </article>
  </div>
</section>

<div class="item-lightbox" data-gallery-modal aria-hidden="true">
  <button type="button" class="item-lightbox__backdrop" data-gallery-close aria-label="Close preview"></button>
  <div class="item-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Image preview">
    <button type="button" class="item-lightbox__close" data-gallery-close aria-label="Close preview">
      <i class="bi bi-x-lg"></i>
    </button>
    <div class="item-lightbox__topbar">
      <span class="item-lightbox__counter" data-gallery-counter>1 / 1</span>
    </div>
    <div class="item-lightbox__stage">
      <button
        type="button"
        class="item-lightbox__nav item-lightbox__nav--prev"
        data-gallery-prev
        aria-label="Previous photo"
      >
        <i class="bi bi-chevron-left"></i>
      </button>
      <img
        src="<%= safeGalleryImages[0] %>"
        alt="<%= item.title %>"
        class="item-lightbox__image"
        data-gallery-modal-image
        onerror="
          this.onerror = null;
          this.src = '/images/hero-bg.jpg';
        "
      />
      <button
        type="button"
        class="item-lightbox__nav item-lightbox__nav--next"
        data-gallery-next
        aria-label="Next photo"
      >
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>
    <div class="item-lightbox__thumbs" data-gallery-modal-thumbs>
      <% safeGalleryImages.forEach((imgUrl, idx) => { %>
      <button
        type="button"
        class="item-lightbox__thumb <%= idx === 0 ? 'is-active' : '' %>"
        data-gallery-modal-thumb
        data-src="<%= imgUrl %>"
        aria-label="Select photo <%= idx + 1 %>"
      >
        <img
          src="<%= imgUrl %>"
          alt=""
          loading="lazy"
          referrerpolicy="no-referrer"
          onerror="
            this.onerror = null;
            this.src = '/images/hero-bg.jpg';
          "
        />
      </button>
      <% }) %>
    </div>
  </div>
</div>

