<script>
  (() => {
    try {
      if (new URLSearchParams(window.location.search).get("posted") === "1") {
        indexedDB.deleteDatabase("findit-report");
        const u = new URL(window.location.href);
        u.searchParams.delete("posted");
        const qs = u.searchParams.toString();
        window.history.replaceState({}, "", u.pathname + (qs ? `?${qs}` : "") + u.hash);
      }
    } catch (_e) {}
  })();
</script>

<script>
  (() => {
    const slot = document.querySelector("[data-reporter-privacy-slot]");
    const btn = document.querySelector("[data-reporter-privacy-trigger]");
    const tip = document.querySelector("[data-reporter-privacy-tip]");
    if (!slot || !btn || !tip) return;

    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      tip.hidden = true;
    };
    const open = () => {
      btn.setAttribute("aria-expanded", "true");
      tip.hidden = false;
    };

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (btn.getAttribute("aria-expanded") === "true") {
        close();
      } else {
        open();
      }
    });

    document.addEventListener("click", (e) => {
      if (!slot.contains(e.target)) {
        close();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        close();
      }
    });
  })();
</script>

<script>
  (() => {
    const mainImage = document.querySelector("[data-gallery-main-image]");
    const thumbs = Array.from(document.querySelectorAll("[data-gallery-thumb]"));
    const openTrigger = document.querySelector("[data-gallery-open]");
    const modal = document.querySelector("[data-gallery-modal]");
    const modalImage = document.querySelector("[data-gallery-modal-image]");
    const modalThumbs = Array.from(document.querySelectorAll("[data-gallery-modal-thumb]"));
    const btnPrev = document.querySelector("[data-gallery-prev]");
    const btnNext = document.querySelector("[data-gallery-next]");
    const counter = document.querySelector("[data-gallery-counter]");
    const closeBtns = Array.from(document.querySelectorAll("[data-gallery-close]"));
    if (!mainImage || !thumbs.length || !modal || !modalImage) return;

    const images = thumbs.map((thumb) => thumb.getAttribute("data-src")).filter(Boolean);
    if (!images.length) return;
    let currentIndex = 0;

    const setActive = (index) => {
      currentIndex = Math.max(0, Math.min(index, images.length - 1));
      const src = images[currentIndex];
      mainImage.src = src;
      modalImage.src = src;
      thumbs.forEach((thumb, idx) => thumb.classList.toggle("is-active", idx === currentIndex));
      modalThumbs.forEach((thumb, idx) => thumb.classList.toggle("is-active", idx === currentIndex));
      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${images.length}`;
      }
      if (btnPrev) btnPrev.hidden = currentIndex === 0;
      if (btnNext) btnNext.hidden = currentIndex === images.length - 1;
    };

    const openModal = () => {
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };
    const closeModal = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    thumbs.forEach((thumb, idx) => thumb.addEventListener("click", () => setActive(idx)));
    modalThumbs.forEach((thumb, idx) => thumb.addEventListener("click", () => setActive(idx)));
    if (btnPrev) btnPrev.addEventListener("click", () => setActive(currentIndex - 1));
    if (btnNext) btnNext.addEventListener("click", () => setActive(currentIndex + 1));
    closeBtns.forEach((btn) => btn.addEventListener("click", closeModal));
    openTrigger.addEventListener("click", openModal);
    openTrigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openModal();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (!modal.classList.contains("is-open")) return;
      if (event.key === "Escape") closeModal();
      if (event.key === "ArrowLeft" && currentIndex > 0) setActive(currentIndex - 1);
      if (event.key === "ArrowRight" && currentIndex < images.length - 1) setActive(currentIndex + 1);
    });

    setActive(0);
  })();
</script>
