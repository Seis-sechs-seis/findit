<section class="auth-shell auth-shell--simple">
  <div class="auth-simple">
    <div class="auth-simple__card">
      <div class="auth-simple__mark" aria-hidden="true">
        <div class="auth-simple__mark-ring">
          <img
            src="/images/ic_transparent.png"
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 object-contain"
            decoding="async"
          />
        </div>
      </div>

      <h2 class="text-center text-lg font-bold text-main mb-0.5">Reset your password</h2>
      <p class="text-center text-sm text-secondary mb-4">Enter your email and we'll send a reset link.</p>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="alert alert-danger mb-3" role="alert">
        <p class="fi-notice__lead text-sm font-semibold">Fix these:</p>
        <ul class="fi-notice__list text-xs">
          <% errors.forEach(err => { %>
          <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success mb-4" role="alert" data-fi-dismiss-ms="6000"><%= success %></div>
      <a href="/login" class="btn btn-primary w-full">Back to login</a>
      <% } else { %>
      <form method="POST" action="/forgot-password" novalidate class="space-y-3" data-auth-form>
        <div class="field">
          <label for="email" class="field-label">Email address</label>
          <input
            type="email"
            class="field-input"
            id="email"
            name="email"
            placeholder="email@example.com"
            value="<%= formData.email || '' %>"
            required
            autocomplete="email"
            data-validate="email"
          />
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>
        <button type="submit" class="btn btn-primary w-full" data-loading-text="Sending...">Send reset link</button>
      </form>

      <p class="text-center text-xs mt-4 text-secondary">
        <a href="/login" class="text-decoration-none text-primary hover:opacity-70">Back to login</a>
      </p>
      <% } %>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-auth-form]");
    if (!form) return;
    const email = form.querySelector("#email");
    let touched = false;
    const validate = () => {
      const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email.value || "").trim());
      if (touched) {
        email.classList.toggle("is-invalid", !ok);
        email.classList.toggle("is-valid", ok && email.value.trim().length > 0);
      }
      return ok;
    };
    email.addEventListener("input", validate);
    email.addEventListener("blur", () => {
      touched = true;
      validate();
    });
    form.addEventListener("submit", (event) => {
      touched = true;
      if (!validate()) {
        event.preventDefault();
        return;
      }
      const submitBtn = form.querySelector("[data-loading-text]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitBtn.getAttribute("data-loading-text");
      }
    });
  })();
</script>
