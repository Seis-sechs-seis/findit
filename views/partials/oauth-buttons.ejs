<% const p = typeof oauthProviders !== 'undefined' ? oauthProviders : {}; %>
<% const showSocial = Boolean(p.google || p.github); %>
<% if (showSocial) { %>
<% const _on = typeof nextUrl !== 'undefined' ? nextUrl : '/'; const _oq = encodeURIComponent(_on); %>
<div class="my-3 flex items-center gap-3" data-oauth-social-row>
  <div class="flex-1 h-px" style="background: var(--border)"></div>
  <span class="text-xs text-muted-custom">or continue with</span>
  <div class="flex-1 h-px" style="background: var(--border)"></div>
</div>
<div class="flex flex-wrap justify-center gap-2" data-oauth-icon-links>
  <% if (p.google) { %>
  <a
    href="/auth/oauth/google/start?next=<%= _oq %>"
    class="btn btn-outline btn-sm inline-flex items-center justify-center min-w-[2.5rem]"
    rel="nofollow"
    title="Google"
    aria-label="Continue with Google"
  >
    <i class="bi bi-google" aria-hidden="true"></i>
  </a>
  <% } %>
  <% if (p.github) { %>
  <a
    href="/auth/oauth/github/start?next=<%= _oq %>"
    class="btn btn-outline btn-sm inline-flex items-center justify-center min-w-[2.5rem]"
    rel="nofollow"
    title="GitHub"
    aria-label="Continue with GitHub"
  >
    <i class="bi bi-github" aria-hidden="true"></i>
  </a>
  <% } %>
</div>
<% } %>
