<footer
  class="border-t-base mt-auto"
  style="background: var(--page-alt); padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px))"
>
  <div class="gutter py-10 sm:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 pb-8 border-b-base">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="brand-mark-wrap inline-flex h-7 w-7 shrink-0 items-center justify-center"
            ><%- include('logo') %></span
          >
          <span class="font-bold text-sm text-main"><%= appName %></span>
        </div>
        <p class="text-sm text-secondary leading-relaxed">
          A centralized place to report, search, and recover lost belongings—so your community can reunite people with
          their stuff faster.
        </p>
      </div>
      <div>
        <h6 class="text-xs font-bold uppercase tracking-widest text-muted-custom mb-4">Quick Links</h6>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-sm text-secondary hover:text-main transition-colors text-decoration-none">Home</a>
          </li>
          <li>
            <a href="/items" class="text-sm text-secondary hover:text-main transition-colors text-decoration-none"
              >Browse</a
            >
          </li>
          <li>
            <a href="/report" class="text-sm text-secondary hover:text-main transition-colors text-decoration-none"
              >Report</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h6 class="text-xs font-bold uppercase tracking-widest text-muted-custom mb-4">Legal</h6>
        <ul class="space-y-1">
          <li>
            <a
              href="/terms"
              class="footer-legal-link text-sm text-secondary hover:text-main transition-colors text-decoration-none inline-flex min-h-[44px] items-center py-1 -my-1"
              >Terms</a
            >
          </li>
          <li>
            <a
              href="/privacy"
              class="footer-legal-link text-sm text-secondary hover:text-main transition-colors text-decoration-none inline-flex min-h-[44px] items-center py-1 -my-1"
              >Privacy</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs text-muted-custom">&copy; <%= currentYear %> Team Seis sechs seis. All rights reserved.</p>
      <a
        href="https://github.com/Seis-sechs-seis/FindIT/fork"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md border border-current px-3 py-1.5 text-xs font-medium text-muted-custom hover:text-main hover:border-main transition-colors text-decoration-none"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/>
        </svg>
        Fork this repo
      </a>
    </div>
  </div>
</footer>
