<section class="auth-shell auth-shell--simple">
  <div class="auth-simple">
    <div class="auth-simple__card">
      <div class="auth-simple__mark" aria-hidden="true">
        <div class="auth-simple__mark-ring">
          <img
            src="/images/ic_transparent.png"
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 object-contain"
            decoding="async"
          />
        </div>
      </div>

      <h2 class="text-center text-lg font-bold text-main mb-0.5">Verify your email</h2>
      <p class="text-center text-sm text-secondary mb-4">
        We've sent a 6-digit code to<br />
        <strong class="text-main"><%= formData.email || 'your inbox' %></strong>.
      </p>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="alert alert-danger mb-3" role="alert">
        <p class="fi-notice__lead text-sm font-semibold">Fix these:</p>
        <ul class="fi-notice__list text-xs">
          <% errors.forEach(err => { %>
          <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success mb-4" role="alert" data-fi-dismiss-ms="6000"><%= success %></div>
      <% } %>
      <form method="POST" action="/verify-email" novalidate class="space-y-3" data-verify-otp-form>
        <input type="hidden" name="next" value="<%= typeof nextUrl !== 'undefined' ? nextUrl : '/' %>" />

        <div class="field">
          <label for="otpCode" class="field-label text-center w-full">6-digit code</label>
          <input
            type="text"
            class="field-input text-center text-lg tracking-widest font-bold"
            id="otpCode"
            name="otpCode"
            placeholder="000000"
            value="<%= formData.otpCode || '' %>"
            required
            maxlength="6"
            pattern="[0-9]{6}"
            inputmode="numeric"
            autocomplete="one-time-code"
            style="letter-spacing: 0.35em"
          />
        </div>

        <button type="submit" class="btn btn-primary w-full" data-loading-text="Verifying…">Verify</button>
      </form>

      <form
        method="POST"
        action="/verify-email/resend"
        class="mt-3 space-y-2"
        data-otp-resend
        data-resend-cooldown="60"
      >
        <input type="hidden" name="next" value="<%= typeof nextUrl !== 'undefined' ? nextUrl : '/' %>" />
        <button type="submit" class="btn btn-secondary w-full text-sm" data-resend-button>
          <span data-resend-label>Resend code</span>
        </button>
        <p class="text-xs text-center text-secondary" data-resend-hint aria-live="polite"></p>
      </form>

      <p class="text-center text-xs mt-4 text-secondary">
        <a href="/login" class="text-decoration-none text-primary hover:opacity-70">Back to login</a>
      </p>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-verify-otp-form]");
    if (!form) return;
    const otp = form.querySelector("#otpCode");
    form.addEventListener("submit", () => {
      const submitBtn = form.querySelector("[data-loading-text]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitBtn.getAttribute("data-loading-text");
      }
    });
    otp.addEventListener("input", () => {
      otp.value = String(otp.value || "")
        .replace(/\D/g, "")
        .slice(0, 6);
    });
  })();
</script>
