<script>
  (() => {
    document.querySelectorAll("[data-bar-value]").forEach((bar) => {
      const n = Number(bar.getAttribute("data-bar-value"));
      const safe = Number.isFinite(n) ? Math.max(0, Math.min(100, n)) : 0;
      bar.style.width = safe + "%";
    });

    function getPageItems(root) {
      const articles = root.querySelectorAll(".dashboard-request-stack > .dashboard-request-item");
      if (articles.length) return Array.from(articles);
      const rows = root.querySelectorAll("tbody tr");
      return Array.from(rows);
    }

    function buildPageList(current, total) {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const set = new Set([1, total]);
      const add = (p) => {
        if (p >= 1 && p <= total) set.add(p);
      };
      add(current);
      add(current - 1);
      add(current + 1);
      add(current - 2);
      add(current + 2);
      const sorted = [...set].sort((a, b) => a - b);
      const out = [];
      let last = 0;
      sorted.forEach((p) => {
        if (last && p - last > 1) out.push("ellipsis");
        out.push(p);
        last = p;
      });
      return out;
    }

    function setupPaginate(root) {
      const state = { page: 1 };
      const pager = root.querySelector(".dashboard-pager");
      const numsEl = root.querySelector(".dashboard-pager__nums");
      const prevBtn = root.querySelector("[data-pager-prev]");
      const nextBtn = root.querySelector("[data-pager-next]");
      let pageSize = Math.max(1, Number(root.getAttribute("data-page-size")) || 6);
      const mq = window.matchMedia("(min-width: 768px)");
      const bumpSize = () => {
        const base = Math.max(1, Number(root.getAttribute("data-page-size")) || 6);
        pageSize = mq.matches ? Math.max(base, 8) : base;
      };
      bumpSize();
      if (typeof mq.addEventListener === "function") {
        mq.addEventListener("change", () => {
          bumpSize();
          state.page = 1;
          render();
        });
      } else if (typeof mq.addListener === "function") {
        mq.addListener(() => {
          bumpSize();
          state.page = 1;
          render();
        });
      }

      function poolItems() {
        return getPageItems(root).filter((el) => !el.classList.contains("dash-filter-hidden"));
      }

      function render() {
        const items = getPageItems(root);
        items.forEach((el) => el.classList.remove("dash-page-hidden"));
        const pool = poolItems();
        const totalPages = Math.max(1, Math.ceil(pool.length / pageSize));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * pageSize;
        pool.forEach((el, i) => {
          if (i < start || i >= start + pageSize) el.classList.add("dash-page-hidden");
        });
        items.forEach((el) => {
          if (el.classList.contains("dash-filter-hidden")) el.classList.add("dash-page-hidden");
        });

        if (!pager || !numsEl || !prevBtn || !nextBtn) return;
        if (pool.length <= pageSize) {
          pager.hidden = true;
          return;
        }
        pager.hidden = false;
        prevBtn.disabled = state.page <= 1;
        nextBtn.disabled = state.page >= totalPages;
        numsEl.innerHTML = "";
        const list = buildPageList(state.page, totalPages);
        list.forEach((entry) => {
          if (entry === "ellipsis") {
            const span = document.createElement("span");
            span.className = "dashboard-pager__ellipsis";
            span.textContent = "…";
            numsEl.appendChild(span);
            return;
          }
          const b = document.createElement("button");
          b.type = "button";
          b.className = "dashboard-pager__num" + (entry === state.page ? " is-active" : "");
          b.textContent = String(entry);
          b.setAttribute("aria-label", `Page ${entry}`);
          if (entry === state.page) b.setAttribute("aria-current", "page");
          else b.removeAttribute("aria-current");
          b.addEventListener("click", () => {
            state.page = entry;
            render();
          });
          numsEl.appendChild(b);
        });
      }

      prevBtn.addEventListener("click", () => {
        state.page -= 1;
        render();
      });
      nextBtn.addEventListener("click", () => {
        state.page += 1;
        render();
      });

      root._dashPaginateSync = () => {
        state.page = 1;
        render();
      };
      render();
    }

    document.querySelectorAll("[data-dashboard-paginate]").forEach(setupPaginate);

    const filterBtns = document.querySelectorAll("[data-dash-filter]");
    const reportRows = document.querySelectorAll("#dashReportList tbody tr[data-item-type]");
    const reportPaginateRoot = document.querySelector('[data-report-filter="1"]');
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const f = btn.getAttribute("data-dash-filter");
        reportRows.forEach((row) => {
          const match = f === "all" || row.getAttribute("data-item-type") === f;
          row.classList.toggle("dash-filter-hidden", !match);
        });
        if (reportPaginateRoot && typeof reportPaginateRoot._dashPaginateSync === "function") {
          reportPaginateRoot._dashPaginateSync();
        }
      });
    });
  })();
</script>
