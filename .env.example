# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ─── App ──────────────────────────────────────────────────────────────────────

PORT=3000

# Public URL of your app — used in emails and OAuth callbacks.
SITE_URL=http://localhost:3000

# Long random string used to sign sessions. Change this before going live.
SESSION_SECRET=change-me-to-a-long-random-string

# The app name shown in emails.
APP_NAME=FindIt

# ─── Admin ────────────────────────────────────────────────────────────────────

# This email is always treated as admin, even after re-login.
# If left empty, the first user to sign up becomes admin instead.
ADMIN_EMAIL=admin@example.com

# ─── Database ─────────────────────────────────────────────────────────────────

# Which database to use: mysql or supabase
DB_PROVIDER=mysql

# MySQL — only needed when DB_PROVIDER=mysql
# Tip: use 127.0.0.1 on Windows if "localhost" resolves to IPv6.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=findit

# Supabase — only needed when DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=           # fallback if no service role key
# SUPABASE_ITEM_IMAGES_BUCKET= # bucket for item photos (default: item-images)
# SUPABASE_STORAGE_BUCKET=     # single-bucket fallback
# SUPABASE_AVATAR_BUCKET=      # bucket for avatars (default: avatars)

# ─── Email / OTP ──────────────────────────────────────────────────────────────

# SMTP credentials for sending verification and password-reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=

# OTP delivery mode: smtp (default) or log (prints to console, dev only).
# OTP_EMAIL_MODE=smtp

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────

# Shown in the browser widget — safe to be public.
CLOUDFLARE_TURNSTILE_SITE_KEY=

# Used server-side only — keep this secret.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ─── OAuth (optional) ─────────────────────────────────────────────────────────

# Create OAuth apps at console.cloud.google.com and github.com/settings/developers.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# Second GitHub app for local dev only (http://localhost callbacks):
# OAUTH_GITHUB_CLIENT_ID_LOCAL=
# OAUTH_GITHUB_CLIENT_SECRET_LOCAL=
# Use when the app is opened via LAN IP but OAuth callbacks need a different base URL:
# OAUTH_SITE_URL=http://192.168.1.x:3000

# ─── Tuning (optional) ────────────────────────────────────────────────────────

# Set to 1 if the app is behind a reverse proxy (Vercel, Nginx, etc.)
# TRUST_PROXY=1

# OTP / reset token lifetimes in minutes/seconds
# OTP_EXPIRY_MINUTES=10
# RESET_TOKEN_EXPIRY_MINUTES=20
